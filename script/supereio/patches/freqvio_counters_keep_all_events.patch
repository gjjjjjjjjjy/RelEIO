+// FreqVIO: count event packets that upstream drops (it keeps only the newest unprocessed packet), and with
+// SUPEREIO_KEEP_ALL_EVENTS=1 keep every packet in arrival order instead. Unset: upstream behaviour, only counted.
+static long freqvio_received = 0, freqvio_dropped = 0;
+static size_t freqvio_max_queue = 0;
+static const bool freqvio_keep_all = getenv("SUPEREIO_KEEP_ALL_EVENTS") != nullptr &&
+                                     std::string(getenv("SUPEREIO_KEEP_ALL_EVENTS")) == "1";
+
+void freqvio_print_event_counts(const char *when) {
+    printf("[freqvio] %s: event packets received %ld dropped %ld max queue %zu keep_all %d\n", when,
+           freqvio_received, freqvio_dropped, freqvio_max_queue, (int)freqvio_keep_all);
+    fflush(stdout);
+}
+
 void eventsCallback_buf(const dvs_msgs::EventArray &event_msg){
     m_buf.lock();
-    if (!events_buf.empty())
+    freqvio_received++;
+    if (!freqvio_keep_all && !events_buf.empty()) {
       events_buf.pop();
+      freqvio_dropped++;
+    }
     events_buf.push(event_msg);
+    if (events_buf.size() > freqvio_max_queue)
+      freqvio_max_queue = events_buf.size();
+    if (freqvio_received % 200 == 0)
+      freqvio_print_event_counts("running");
     m_buf.unlock();
 }
 
@@ -340,6 +363,9 @@ int main(int argc, char **argv)
     std::thread sync_thread{sync_process};
 
     ros::spin();
+    m_buf.lock();
+    freqvio_print_event_counts("final");
+    m_buf.unlock();
     return 0;
 }
 
